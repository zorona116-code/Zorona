{
  "name": "arabisk-restaurant",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build": "npm run build --workspaces",
    "test": "node --test tests/*.test.mjs",
    "verify:syntax": "node scripts/verify-syntax.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": "24.x",
    "npm": "10.8.2"
  },
  "description": "ZORONA restaurant website (menu, today's offer, table reservations) and administration console"
}
